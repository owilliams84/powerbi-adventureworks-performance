/// One row per order line, 121,253 of them. Every column is hidden; the measures in
/// Metrics own how each amount is aggregated and compared.
table Sales
	lineageTag: 0d3bd417-5afd-58da-8f17-d6978e11ccad

	column 'Line Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: abc50b0e-746b-53dc-a818-3cee34fa1943
		summarizeBy: none
		sourceColumn: LineKey

	column 'Order ID'
		dataType: string
		isHidden
		lineageTag: 83e2ab14-7273-50f6-bbdd-6fa27ad19b3b
		summarizeBy: none
		sourceColumn: OrderID

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: b12c4393-d1b5-53f4-acee-c0b3b27c5be7
		summarizeBy: none
		sourceColumn: OrderDate

	column 'Product Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 02d55f38-260e-565d-8032-366474d37f08
		summarizeBy: none
		sourceColumn: ProductKey

	column 'Territory Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 501d1263-3023-5df6-9b80-f8a35e5fef9b
		summarizeBy: none
		sourceColumn: SalesTerritoryKey

	column 'Reseller Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c7636743-43ef-50cb-ab18-1038d631e525
		summarizeBy: none
		sourceColumn: ResellerKey

	column 'Customer Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 714619dc-30e5-5820-9a43-819401ff9f96
		summarizeBy: none
		sourceColumn: CustomerKey

	column 'Channel Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f1b1fca5-ccdf-5a08-9a54-68361fd65077
		summarizeBy: none
		sourceColumn: ChannelKey

	column 'Line Size Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 448fc948-eceb-57d9-9e58-a13322f68b7f
		summarizeBy: none
		sourceColumn: LineSizeKey

	/// C<customer> or R<reseller>: one key across both channels, so 'Customers' counts
	/// internet customers and resellers together.
	column 'Account Key'
		dataType: string
		isHidden
		lineageTag: 1280c255-ebf3-56e6-b087-7474c6faa75c
		summarizeBy: none
		sourceColumn: AccountKey

	/// Fiscal year of the account's first order in the data. New customers are the
	/// accounts whose first fiscal year is the one on screen.
	column 'Account First FY'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: edd957fb-5947-509c-955b-d1d2ba3a43c5
		summarizeBy: none
		sourceColumn: AccountFirstFY

	column Quantity
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: dc2825a4-adf5-5a3b-9428-86c19e92392a
		summarizeBy: none
		sourceColumn: Quantity

	column 'Unit Price'
		dataType: double
		isHidden
		formatString: \£#,0.00
		lineageTag: da63ef79-d0c7-52d3-85a1-6597a1759b6b
		summarizeBy: none
		sourceColumn: UnitPrice

	/// Quantity at list price, before any discount.
	column 'Extended Amount'
		dataType: double
		isHidden
		formatString: \£#,0.00
		lineageTag: 4755a478-2606-5d4c-bd98-0d12e6b8f108
		summarizeBy: none
		sourceColumn: ExtendedAmount

	column 'Sales Amount'
		dataType: double
		isHidden
		formatString: \£#,0.00
		lineageTag: cefd9184-88e6-5ca9-905a-796b06fcf667
		summarizeBy: none
		sourceColumn: SalesAmount

	column 'Total Product Cost'
		dataType: double
		isHidden
		formatString: \£#,0.00
		lineageTag: 5c4470ea-d54c-57c0-a47a-dec7a5788b23
		summarizeBy: none
		sourceColumn: TotalProductCost

	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/owilliams84/powerbi-adventureworks-performance/main/data/fact_sales.csv"), [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Applied Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"LineKey", Int64.Type}, {"OrderID", type text}, {"OrderDate", type date}, {"ProductKey", Int64.Type}, {"SalesTerritoryKey", Int64.Type}, {"ResellerKey", Int64.Type}, {"CustomerKey", Int64.Type}, {"ChannelKey", Int64.Type}, {"LineSizeKey", Int64.Type}, {"AccountKey", type text}, {"AccountFirstFY", Int64.Type}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"ExtendedAmount", type number}, {"SalesAmount", type number}, {"TotalProductCost", type number}}, "en-US")
				in
				    #"Applied Types"

	annotation PBI_ResultType = Table
