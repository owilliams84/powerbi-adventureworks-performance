/// Internet or Reseller.
table Channel
	lineageTag: 721cb914-5c4f-54b5-9906-c8e460a8b0c7

	column 'Channel Key'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 6a404840-0261-5478-83fc-236e27c574d4
		summarizeBy: none
		sourceColumn: ChannelKey

	column Channel
		dataType: string
		lineageTag: bc3d7736-b680-52e2-aaeb-20f75a9383af
		summarizeBy: none
		sourceColumn: Channel

	partition Channel = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/owilliams84/powerbi-adventureworks-performance/main/data/dim_channel.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Applied Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"ChannelKey", Int64.Type}, {"Channel", type text}}, "en-US")
				in
				    #"Applied Types"

	annotation PBI_ResultType = Table
