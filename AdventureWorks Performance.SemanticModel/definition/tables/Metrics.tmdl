			VAR PtsSel = CONCATENATEX(FILTER(P, 'Date'[Month Index] >= SelStart && 'Date'[Month Index] < SelStart + 12), FORMAT(14 + 'Date'[Month Index] * 5.6, "0.0") & "," & FORMAT(112 - ([@v] - Lo) / Span * 24, "0.0"), " ", 'Date'[Month Index], ASC)
