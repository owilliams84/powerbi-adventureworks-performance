			VAR R = DIVIDE(Me, Mx)
			VAR Bg = SWITCH(TRUE(), R > 0.8, "#111F38", R > 0.6, "#3B4A66", R > 0.4, "#7C8598", R > 0.2, "#BCC1D2", "#E8ECF3")
			VAR Fg = IF(R > 0.4, "#FFFFFF", "#4A5768")
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='66' height='22' viewBox='0 0 66 22' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='1' y='1' width='64' height='20' rx='2' fill='" & Bg & "'/>"
			        & "<text x='33' y='15' font-size='11' text-anchor='middle' fill='" & Fg & "'>" & IF(ABS(Me) >= 1000000, FORMAT(Me / 1000000, "$#,0.0") & "M", IF(ABS(Me) >= 1000, FORMAT(Me / 1000, "$#,0.0") & "K", FORMAT(Me, "$#,0"))) & "</text>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Me), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
