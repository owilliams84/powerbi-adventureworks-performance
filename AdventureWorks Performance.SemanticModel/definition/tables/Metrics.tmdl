	measure 'Cell Season' =
			VAR Me = [Sales]
			VAR Mx = MAXX(CROSSJOIN(ALL('Date'[Fiscal Year], 'Date'[FY Sort]), ALL('Date'[Month], 'Date'[Month No])), CALCULATE([Sales]))
			VAR R = DIVIDE(Me, Mx)
			VAR Bg = SWITCH(TRUE(), R > 0.8, "#111F38", R > 0.6, "#3B4A66", R > 0.4, "#7C8598", R > 0.2, "#BCC1D2", "#E8ECF3")
			VAR Fg = IF(R > 0.4, "#FFFFFF", "#4A5768")
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='30' height='22' viewBox='0 0 30 22' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='1' y='1' width='28' height='20' rx='2' fill='" & Bg & "'/>"
			        & "<text x='15' y='15' font-size='11' text-anchor='middle' fill='" & Fg & "'>" & FORMAT(Me / 1000000, "0.0") & "</text>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Me), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		displayFolder: Formatting
		lineageTag: 0438fe1b-eb2f-5529-80b2-e1d280e4f522

	measure 'Cell Buyer' =
