	/// Pooled with ALL: the table's Top 10 filter would narrow ALLSELECTED to the rows kept.
	measure 'Bar Product Sales' =
			VAR V = [Sales]
			VAR Mx = MAXX(ALL('Product'[Product]), [Sales])
			VAR W = DIVIDE(V, Mx) * 116
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<rect x='0' y='3' width='" & FORMAT(MAX(W, 1), "0.0") & "' height='10' rx='1' fill='#111F38'/></svg>"
			RETURN
			    IF(V > 0, "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		displayFolder: Formatting
		lineageTag: f320672e-0408-57b8-9f69-435f6ef1c79d

	measure 'Bar Subcategory Sales' =
			VAR V = [Sales]
			VAR Mx = MAXX(ALLSELECTED('Product'[Subcategory]), [Sales])
			VAR W = DIVIDE(V, Mx) * 116
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<rect x='0' y='3' width='" & FORMAT(MAX(W, 1), "0.0") & "' height='10' rx='1' fill='#111F38'/></svg>"
			RETURN
			    IF(V > 0, "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		displayFolder: Formatting
		lineageTag: f1aafbf8-ff48-58bf-8ff0-6522098d95c1

	measure 'Bar Region Sales' =
			VAR V = [Sales]
			VAR Mx = MAXX(ALLSELECTED(Territory[Region]), [Sales])
			VAR W = DIVIDE(V, Mx) * 116
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<rect x='0' y='3' width='" & FORMAT(MAX(W, 1), "0.0") & "' height='10' rx='1' fill='#111F38'/></svg>"
			RETURN
			    IF(V > 0, "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		displayFolder: Formatting
		lineageTag: c433ce71-2648-5b5b-bf26-dbac980f51ba

	measure 'Bar Discount' =
			VAR V = [Discount]
			VAR Mx = MAXX(ALLSELECTED('Line Size'[Line Size]), [Discount])
			VAR W = DIVIDE(V, Mx) * 116
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<rect x='0' y='3' width='" & FORMAT(MAX(W, 1), "0.0") & "' height='10' rx='1' fill='#C9A227'/></svg>"
			RETURN
			    IF(V > 0, "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		displayFolder: Formatting
		lineageTag: 9587f074-f1e7-5bb2-bda3-be60f9353247

	measure 'Model Profit Colour' = IF([Gross Profit] < 0, "#7C8598", "#111F38")
		displayFolder: Formatting
		lineageTag: bd18d6e7-6920-55d1-b8ad-91aee4837c49

	measure 'Product Rank' =
			VAR Me = [Sales]
			VAR Mine = SELECTEDVALUE('Product'[Product])
			VAR Pool = FILTER(ALL('Product'[Product]), [Sales] > 0)
			RETURN
			    IF(
			        HASONEVALUE('Product'[Product]) && [Sales] > 0,
			        COUNTROWS(FILTER(Pool, [Sales] > Me))
			            + COUNTROWS(FILTER(Pool, [Sales] = Me && 'Product'[Product] < Mine)) + 1
			    )
		formatString: 0
		displayFolder: Ranks
		lineageTag: 60f6404c-64f2-5a67-b57b-e37c4555da8a

	measure 'Subcategory Rank' =
			VAR Me = [Sales]
			VAR Mine = SELECTEDVALUE('Product'[Subcategory])
			VAR Pool = FILTER(ALL('Product'[Subcategory]), [Sales] > 0)
			RETURN
			    IF(
			        HASONEVALUE('Product'[Subcategory]) && [Sales] > 0,
			        COUNTROWS(FILTER(Pool, [Sales] > Me))
			            + COUNTROWS(FILTER(Pool, [Sales] = Me && 'Product'[Subcategory] < Mine)) + 1
			    )
		formatString: 0
		displayFolder: Ranks
		lineageTag: d482a527-c5ce-599d-8bb8-aabe2dc5c06d

	measure 'Reseller Rank' =
			VAR Me = [Sales]
			VAR Mine = SELECTEDVALUE(Reseller[Reseller])
			VAR Pool = FILTER(ALL(Reseller[Reseller]), [Sales] > 0 && Reseller[Reseller] <> "(Internet sale)")
			RETURN
			    IF(
			        HASONEVALUE(Reseller[Reseller]) && [Sales] > 0 && Mine <> "(Internet sale)",
			        COUNTROWS(FILTER(Pool, [Sales] > Me))
			            + COUNTROWS(FILTER(Pool, [Sales] = Me && Reseller[Reseller] < Mine)) + 1
			    )
		formatString: 0
		displayFolder: Ranks
		lineageTag: e9aefef1-f48b-5f79-8f41-7e7df73ff550

	measure 'Model Profit Rank' =
			VAR Me = [Gross Profit]
			VAR Mine = SELECTEDVALUE('Product'[Model])
			VAR Pool = FILTER(ALL('Product'[Model]), NOT ISBLANK([Sales]))
			RETURN
			    IF(
			        HASONEVALUE('Product'[Model]) && NOT ISBLANK([Sales]),
			        COUNTROWS(FILTER(Pool, [Gross Profit] > Me))
			            + COUNTROWS(FILTER(Pool, [Gross Profit] = Me && 'Product'[Model] < Mine)) + 1
			    )
		formatString: 0
		displayFolder: Ranks
		lineageTag: 6a453d6b-84d2-5fd7-ab52-d3545d27954c

	measure 'Model Loss Rank' =
			VAR Me = [Gross Profit]
			VAR Mine = SELECTEDVALUE('Product'[Model])
			VAR Pool = FILTER(ALL('Product'[Model]), NOT ISBLANK([Sales]))
			RETURN
			    IF(
			        HASONEVALUE('Product'[Model]) && NOT ISBLANK([Sales]),
			        COUNTROWS(FILTER(Pool, [Gross Profit] < Me))
			            + COUNTROWS(FILTER(Pool, [Gross Profit] = Me && 'Product'[Model] < Mine)) + 1
			    )
		formatString: 0
		displayFolder: Ranks
		lineageTag: 9abbd6b6-7116-5b46-a4e3-bd945b26dc7e

	/// 1 for the 7 most and 3 least profitable models: the chart filters on it. The sales test
	/// matters: a model with no sales has a blank rank, and BLANK <= 12 is true.
	measure 'Model Shown' = IF(NOT ISBLANK([Sales]) && ([Model Profit Rank] <= 7 || [Model Loss Rank] <= 3), 1)
		formatString: 0
		displayFolder: Ranks
		lineageTag: a62dc71e-fe57-5d59-bfc0-d9b025133dc6

	column Placeholder
		dataType: string
		isHidden
		lineageTag: fdc3200e-3408-5e4e-99bd-b301a4c395c3
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition Metrics = calculated
		mode: import
		source = ROW("Placeholder", "")
