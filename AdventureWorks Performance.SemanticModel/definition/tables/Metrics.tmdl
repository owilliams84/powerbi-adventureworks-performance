	measure 'Card Customers Total' =
			VAR Note = VAR P = [Customers PY] VAR C = DIVIDE([Customers] - P, P) RETURN IF(ISBLANK(P), "No prior year to compare", IF(C >= 0, "Up ", "Down ") & FORMAT(ABS(C), "0.0%") & " on " & [Comparison Label])
			VAR NoteCol = VAR P = [Customers PY] RETURN IF(ISBLANK(P), "#667284", IF([Customers] >= P, "#1E7A4C", "#B3261E"))
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='96' viewBox='0 0 336 96' font-family='Segoe UI, sans-serif'>"
			        & "<rect x='0.5' y='0.5' width='335' height='95' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='96' fill='#C9A227'/>"
			        & "<text x='16' y='22' font-size='11' font-weight='700' fill='#667284'>CUSTOMERS</text>"
			        & "<text x='16' y='56' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT([Customers], "#,0") & "</text>"
			        & "<text x='16' y='81' font-size='11.5' fill='" & NoteCol & "'>" & Note & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		displayFolder: Cards
		lineageTag: 462d269d-1255-5e3e-987c-8b83d8922133

