{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "pgSummary",
  "displayName": "Executive summary",
  "displayOption": "FitToPage",
  "height": 900,
  "width": 1440,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F4F6FA'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "displayArea": [
      {
        "properties": {
          "verticalAlignment": {
            "expr": {
              "Literal": {
                "Value": "'Top'"
              }
            }
          }
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "vFYSum",
      "target": "vMonthlySum",
      "type": "NoFilter"
    },
    {
      "source": "vFYSum",
      "target": "vSeasonSum",
      "type": "NoFilter"
    }
  ]
}
